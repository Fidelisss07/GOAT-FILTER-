{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goat Filter",
  "version": "0.1.0",
  "identifier": "com.goatfilter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Goat Filter",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "visible": false,
        "resizable": true,
        "backgroundColor": "#111118"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Goat Filter",
    "shortDescription": "Digital Vibrance e Super Vibrance para jogos",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"],
        "installMode": "currentUser"
      }
    }
  }
}
