# Copie para .env e preencha. NUNCA suba o .env para o GitHub.

# Token do bot (Discord Developer Portal > sua aplicação > Bot > Reset Token)
DISCORD_TOKEN=cole_o_token_aqui

# ID da aplicação (Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID do servidor (clique com o botão direito no nome do servidor > Copiar ID do servidor).
# Precisa ligar o Modo Desenvolvedor no Discord (Configurações > Avançado).
GUILD_ID=

# Cargo da equipe de suporte (quem vê e responde os tickets). Opcional, mas recomendado.
STAFF_ROLE_ID=

# Categoria onde os canais de ticket são criados. Opcional: se vazio, cria solto.
TICKET_CATEGORY_ID=

# Canal onde caem os registros (tickets abertos/fechados, transcrições, erros). Opcional.
LOG_CHANNEL_ID=

# Canal de boas-vindas para novos membros. Opcional.
WELCOME_CHANNEL_ID=

# Endereço do site (usado nas respostas e no download).
SITE_URL=https://www.goatfilter.xyz
