# Copie para .env e preencha. NUNCA suba o .env para o GitHub.

# Token do bot (Discord Developer Portal > sua aplicação > Bot > Reset Token)
DISCORD_TOKEN=cole_o_token_aqui

# ID da aplicação (Developer Portal > General Information > Application ID)
CLIENT_ID=1575604897645199511

# O resto é OPCIONAL: no servidor, rode /configurar e o bot cria sozinho o
# cargo "Equipe Goat Filter", a categoria "Tickets" e os canais #suporte,
# #registros e #boas-vindas. Só preencha abaixo se quiser usar canais que já existem.
GUILD_ID=
STAFF_ROLE_ID=
TICKET_CATEGORY_ID=
LOG_CHANNEL_ID=
WELCOME_CHANNEL_ID=

# Endereço do site (usado nas respostas e no download).
SITE_URL=https://www.goatfilter.xyz
